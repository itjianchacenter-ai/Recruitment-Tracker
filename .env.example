# =====================================================================
# Recruitment 120 Days — Environment variables
# Copy this file to .env.local for local dev.
# In your host (Vercel/Azure/etc.) set the same keys as project secrets.
# =====================================================================

# ---- Frontend (safe to expose — bundled into the client) ------------
# These VITE_* vars are PUBLIC. Never put secrets here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
VITE_DEFAULT_ACTOR=HR
# Public base URL of the deployed app (used to build magic links / upload links)
VITE_APP_BASE_URL=https://recruitment.jianchatea.com

# =====================================================================
# SERVER-SIDE SECRETS — DO NOT prefix with VITE_ and DO NOT expose to the
# browser. These belong in a backend (Supabase Edge Function / serverless
# API route / Azure Function), never in client code.
# =====================================================================

# ---- Supabase service role (server only) ----------------------------
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-SERVICE-ROLE-KEY

# ---- Microsoft 365 / Graph API (sending email as Hr.jc@jianchatea.com)
# Register an app in Entra ID (Azure AD). Grant APPLICATION permission
# Mail.Send (admin consent). Use a shared mailbox or licensed mailbox.
M365_TENANT_ID=YOUR-TENANT-ID
M365_CLIENT_ID=YOUR-APP-CLIENT-ID
M365_CLIENT_SECRET=YOUR-APP-CLIENT-SECRET
M365_SENDER_ADDRESS=Hr.jc@jianchatea.com

# ---- Magic-link / token signing (Approver + Candidate links) --------
LINK_SIGNING_SECRET=generate-a-long-random-string
